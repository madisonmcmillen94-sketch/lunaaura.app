{
  "functions": {
    "api/download-deepening.ts": {
      "includeFiles": "assets/the-deepening-all-access-workbook.pdf"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-reminders?period=morning", "schedule": "0 12 * * *" },
    { "path": "/api/send-reminders?period=evening", "schedule": "0 0 * * *" }
  ]
}
