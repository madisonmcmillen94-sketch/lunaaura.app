# --- Client-side Firebase config (public, safe to expose in the browser) ---
# From Firebase console → Project settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-only secrets (Vercel serverless function /api/forecast) ---
# NEVER put these in a VITE_ variable -- they must stay server-side only.
# From Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# From platform.openai.com -> API keys
OPENAI_API_KEY=

# --- Stripe (subscriptions: Plus + All Access tiers) ---
# From dashboard.stripe.com -> Developers -> API keys. Use the TEST secret key
# (starts sk_test_) while verifying the flow, switch to the live one later.
STRIPE_SECRET_KEY=

# From dashboard.stripe.com -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# From dashboard.stripe.com -> Product catalog -> each Price's ID (starts price_)
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_ALL_ACCESS_MONTHLY=
STRIPE_PRICE_ALL_ACCESS_YEARLY=
